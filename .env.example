# Configurações do Eventox para Produção VPS
NODE_ENV=production
HOST=127.0.0.1
PORT=3050
DATABASE_PATH=./data/eventox.db

# Chave secreta de 32+ bytes para assinar sessões com HMAC-SHA256 (obrigatório em produção)
# Gere no terminal com: openssl rand -hex 32
SESSION_SECRET=substitua_por_um_segredo_criptografico_longo_e_aleatorio

# Google Drive OAuth (Callback: https://evento.kazix.site/api/drive/callback)
GOOGLE_DRIVE_CALLBACK_URL=https://evento.kazix.site/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_SYNC_SECRET=

# Cloudflare R2 (API S3 compatível - se omitido, usa armazenamento em disco local data/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
